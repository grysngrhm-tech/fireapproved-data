  "@type": "sc:Dataset",
  "name": "CAL FIRE OSFM Building Materials Listing — WUI category censuses",
  "description": "276 listed wildland-urban-interface building products across 16 OSFM category codes, from a frozen snapshot. Every listing in a covered category is present. Each row keeps the listing ID, the product name as the listing records it, the BML application number, and the expiry.",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://fireapproved.com/data/",
  "version": "2026.08.25",
  "datePublished": "2026-08-25",
  "creator": {
    "@type": "Organization",
    "name": "FireApproved",
    "url": "https://fireapproved.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FireApproved",
    "url": "https://fireapproved.com"
  },
  "keywords": [
    "wildfire",
    "defensible space",
    "home hardening",
    "plant flammability",
    "building codes",
    "wildland-urban interface"
  ],
  "citeAs": "FireApproved.com (2026). CAL FIRE OSFM Building Materials Listing — WUI category censuses [Data set]. https://fireapproved.com/data/",
